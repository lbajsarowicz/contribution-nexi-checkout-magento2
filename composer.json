{
  "name": "nexi-checkout/magento2",
  "description": "Nets Easy Checkout",
  "type": "magento2-module",
  "version": "1.8.7",
  "license" : "MIT",
  "require": {
    "php": "~8.0",
    "giggsey/libphonenumber-for-php-lite": "*"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Dibs\\EasyCheckout\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
